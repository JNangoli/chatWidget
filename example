        const COUNTY_GEOJSON_URL =
            "https://raw.githubusercontent.com/" +
            "plotly/datasets/master/geojson-counties-fips.json";

        const IOWA_FIPS = "19";

        const AUTO_REFRESH_MS = 5 * 60 * 1000;

        const COUNTIES = [
