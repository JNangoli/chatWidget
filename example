/* -------------------------------------------------------------------- *
 * 3. COMPILER
 * -------------------------------------------------------------------- */

const escapeRe = (s) => s.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");

/**
 * "right-of-way acquisition" ->
 *   right[\s.\-]*of[\s.\-]*way[\s.\-]+acquisition(?:s|es|ed|ing)?
 * Separators are elastic, so spacing, hyphens and dots all match.
 */
const termToSource = (term) => {
  const parts = term.split(/[\s-]+/).map(escapeRe);
  const stem = parts.join("[\\s.\\-]*");
  return `${stem}(?:ies|es|s|ed|ing)?`;
};

const normalize = (s) =>
  s
    .toLowerCase()
    .replace(/[.\-_]+/g, " ")
    .replace(/\s+/g, " ")
    .trim()
    .replace(/(?:ies|ing|ed|es|s)$/, "");

const termText = (t) => (typeof t === "string" ? t : t.t);
const termWeight = (t) => (typeof t === "string" ? 1 : t.w ?? 1);

/**
 * Compiles the whole taxonomy into:
 *   wordRe     — one /gi regex, named group per category
 *   acroRe     — one /g  regex (case-sensitive), named group per category
 *   lookup     — normalized surface -> { canonical, category, weight }
 *   vocabulary — flat list used by the fuzzy pass
 */
export function compile(taxonomy = TAXONOMY, aliases = ALIASES) {
  const lookup = new Map();
  const owners = new Map(); // surface -> every category that claims it
  const vocabulary = [];
  const wordParts = [];
  const acroParts = [];
  const claim = (surface, category) => {
    const key = normalize(surface);
    if (!owners.has(key)) owners.set(key, new Set());
    owners.get(key).add(category);
  };

  for (const [category, def] of Object.entries(taxonomy)) {
    const entries = def.terms.map((t) => ({
      canonical: termText(t),
      weight: termWeight(t),
    }));

    // Fold aliases into the category that owns their canonical term.
    const owned = new Set(entries.map((e) => normalize(e.canonical)));
    for (const [alias, canonical] of Object.entries(aliases)) {
      if (owned.has(normalize(canonical))) {
        const parent = entries.find((e) => normalize(e.canonical) === normalize(canonical));
        entries.push({ canonical, weight: parent ? parent.weight : 1, surface: alias });
      }
    }

    for (const e of entries) {
      const surface = e.surface || e.canonical;
      claim(surface, category);
      lookup.set(normalize(surface), {
        canonical: e.canonical,
        category,
        weight: e.weight,
      });
      vocabulary.push({ surface, canonical: e.canonical, category, weight: e.weight });
    }

    // Longest first: "road closure" must win before "road".
    const sources = [...new Set(entries.map((e) => e.surface || e.canonical))]
      .sort((a, b) => b.length - a.length)
      .map(termToSource);

    wordParts.push(`(?<${category}>${sources.join("|")})`);

    if (def.acronyms?.length) {
      const acros = [...def.acronyms].sort((a, b) => b.length - a.length).map(escapeRe);
      acroParts.push(`(?<${category}>${acros.join("|")})`);
      for (const a of def.acronyms) {
        claim(a, category);
        if (!lookup.has(normalize(a))) {
          lookup.set(normalize(a), { canonical: a, category, weight: 2 });
        }
      }
    }
  }

  return {
    wordRe: new RegExp(`(?<![\\w-])(?:${wordParts.join("|")})(?![\\w-])`, "gi"),
    acroRe: new RegExp(`(?<![\\w-])(?:${acroParts.join("|")})(?![\\w-])`, "g"),
    lookup,
    owners,
    vocabulary,
    categories: Object.keys(taxonomy),
    taxonomy,
  };
}

/* -------------------------------------------------------------------- *
 * 4. FUZZY RECOVERY (bounded Levenshtein — early exit, never O(n·m) blowup)
 * -------------------------------------------------------------------- */

export function editDistance(a, b, max = 2) {
  if (Math.abs(a.length - b.length) > max) return max + 1;
  let prev = Array.from({ length: b.length + 1 }, (_, i) => i);
  for (let i = 1; i <= a.length; i++) {
    const cur = [i];
    let best = i;
    for (let j = 1; j <= b.length; j++) {
      const cost = a[i - 1] === b[j - 1] ? 0 : 1;
      cur[j] = Math.min(prev[j] + 1, cur[j - 1] + 1, prev[j - 1] + cost);
      if (cur[j] < best) best = cur[j];
    }
    if (best > max) return max + 1; // whole row already past budget
    prev = cur;
  }
  return prev[b.length];
}

const TOKEN_RE = /[\p{L}\p{N}]+(?:['’\-][\p{L}\p{N}]+)*/gu;

/* Everyday words that sit one edit away from a real term
   (mile/mill, plan/plat, road/road-…): never fuzzy-match these. */
const FUZZY_STOP = new Set([
  "mile", "miles", "plan", "plans", "place", "point", "phone", "price", "pride",
  "board", "broad", "grade", "grant", "green", "great", "state", "stage", "share",
  "there", "these", "those", "their", "three", "under", "until", "water", "where",
  "while", "white", "whole", "would", "could", "should", "other", "order", "offer",
  "close", "cost", "costs", "count", "court", "cover", "cross", "crews", "level",
  "local", "lower", "north", "south", "first", "final", "field", "front",
]);

function fuzzyPass(text, compiled, claimed) {
  const singles = compiled.vocabulary.filter(
    (v) => !/[\s-]/.test(v.surface) && normalize(v.surface).length >= 5
  );
  const phrases = compiled.vocabulary
    .filter((v) => /[\s-]/.test(v.surface))
    .map((v) => ({ ...v, norm: normalize(v.surface), words: v.surface.split(/[\s-]+/).length }));

  const tokens = [...text.matchAll(TOKEN_RE)];
  const overlaps = (start, end) => claimed.some(([s, e]) => start < e && end > s);
  const out = [];

  /* --- multi-word pass: "culvirt replacment" -> culvert replacement ---
     Sliding 2- and 3-token windows, compared only against vocabulary
     phrases of a compatible length. Both prefilters (first letter, length
     delta) fire before the O(n·m) work, so this stays cheap. */
  for (let i = 0; i < tokens.length; i++) {
    for (const span of [2, 3]) {
      const last = tokens[i + span - 1];
      if (!last) break;
      const start = tokens[i].index;
      const end = last.index + last[0].length;
      if (overlaps(start, end)) continue;
      const norm = normalize(text.slice(start, end));
      if (compiled.lookup.has(norm)) continue;

      let best = null;
      for (const p of phrases) {
        if (p.words !== span) continue;
        const budget = p.norm.length >= 14 ? 3 : 2;
        if (p.norm[0] !== norm[0]) continue;
        if (Math.abs(p.norm.length - norm.length) > budget) continue;
        const d = editDistance(norm, p.norm, budget);
        if (d > 0 && d <= budget && (!best || d < best.distance)) best = { ...p, distance: d };
      }
      if (best) {
        out.push({
          text: text.slice(start, end),
          index: start,
          length: end - start,
          canonical: best.canonical,
          category: best.category,
          weight: best.weight * 0.6,
          kind: "fuzzy",
          distance: best.distance,
        });
      }
    }
  }

  /* --- single-token pass --- */
  for (const m of tokens) {
    const tok = m[0];
    if (tok.length < 5) continue;
    if (FUZZY_STOP.has(tok.toLowerCase())) continue;
    // Never second-guess a span an entity extractor already owns
    // (dates, routes, measurements, IDs).
    if (claimed.some(([s, e]) => m.index < e && m.index + tok.length > s)) continue;

    const norm = normalize(tok);
    // Compare stems, not surfaces: "mile" (4) is too short to risk.
    if (norm.length < 5 || compiled.lookup.has(norm)) continue;

    const budget = norm.length >= 9 ? 2 : 1;
    let best = null;
    for (const v of singles) {
      const target = normalize(v.surface);
      if (target[0] !== norm[0]) continue; // first letter rarely mistyped
      if (Math.abs(target.length - norm.length) > budget) continue;
      const d = editDistance(norm, target, budget);
      if (d <= budget && (!best || d < best.distance)) best = { ...v, distance: d };
      if (best?.distance === 1) break;
    }
    if (best) {
      out.push({
        text: tok,
        index: m.index,
        length: tok.length,
        canonical: best.canonical,
        category: best.category,
        weight: best.weight * 0.6, // fuzzy hits count, but count less
        kind: "fuzzy",
        distance: best.distance,
      });
    }
  }
  return out;
}

/* -------------------------------------------------------------------- *
 * 5. COUNTERS
 * -------------------------------------------------------------------- */

const ABBREV_RE =
  /\b(?:[A-Za-z]|Mr|Mrs|Ms|Dr|Prof|Sr|Jr|St|Ave|Blvd|Rd|Hwy|Dept|Inc|Ltd|Co|Corp|Fig|No|Est|approx|etc|vs|e\.g|i\.e|a\.m|p\.m|U\.S(?:\.A)?)\./gi;

export function countSentences(text) {
  const cleaned = text
    .replace(ABBREV_RE, (m) => m.replace(/\./g, ""))
    .replace(/\d+\.\d+/g, (m) => m.replace(/\./g, ""))
    .replace(/\.{3,}|…/g, "…");
  return (cleaned.match(/[.!?…]+(?=["')\]]?(?:\s|$))/g) || []).length;
}

/** Flesch reading ease, rounded — a cheap "is this plain language?" signal. */
const syllables = (w) =>
  Math.max(1, (w.toLowerCase().replace(/e\b/g, "").match(/[aeiouy]+/g) || []).length);

export function readability(text) {
  const words = text.match(TOKEN_RE) || [];
  const sentences = Math.max(1, countSentences(text));
  if (!words.length) return null;
  const syl = words.reduce((n, w) => n + syllables(w), 0);
  const score = 206.835 - 1.015 * (words.length / sentences) - 84.6 * (syl / words.length);
  const grade = Math.round(0.39 * (words.length / sentences) + 11.8 * (syl / words.length) - 15.59);
  return {
    flesch: Math.round(score),
    grade: Math.max(1, grade),
    label:
      score >= 70 ? "Plain language" : score >= 50 ? "Fairly readable" : score >= 30 ? "Difficult" : "Very difficult",
  };
}

/* -------------------------------------------------------------------- *
 * 6. THE MATCHER
 * -------------------------------------------------------------------- */

export function createMatcher(taxonomy = TAXONOMY, aliases = ALIASES) {
  let custom = structuredClone(taxonomy);
  let compiled = compile(custom, aliases);

  /** Runtime learning: add a term and recompile. */
  const learn = (category, term, weight = 2) => {
    if (!custom[category]) {
      custom[category] = { label: category, color: "#555", terms: [], acronyms: [] };
    }
    const exists = custom[category].terms.some(
      (t) => normalize(termText(t)) === normalize(term)
    );
    if (!exists) custom[category].terms.push({ t: term, w: weight });
    compiled = compile(custom, aliases);
    return compiled;
  };

  const forget = (category, term) => {
    if (!custom[category]) return compiled;
    custom[category].terms = custom[category].terms.filter(
      (t) => normalize(termText(t)) !== normalize(term)
    );
    compiled = compile(custom, aliases);
    return compiled;
  };

  function analyze(text, { fuzzy = true, context = 40 } = {}) {
    if (!text?.trim()) return emptyResult(compiled);

    /* ---- keyword pass (one regex, one sweep) ---- */
    const raw = [];
    const push = (m, kind) => {
      const category = Object.keys(m.groups).find((k) => m.groups[k] !== undefined);
      if (!category) return;
      const meta = compiled.lookup.get(normalize(m[0])) || {};
      raw.push({
        text: m[0],
        index: m.index,
        length: m[0].length,
        canonical: meta.canonical || normalize(m[0]),
        category,
        weight: meta.weight ?? 1,
        kind,
      });
    };

    for (const m of text.matchAll(compiled.wordRe)) push(m, "term");
    for (const m of text.matchAll(compiled.acroRe)) push(m, "acronym");

    let hits = dedupeOverlaps(raw);

    /* ---- entities (also fence off spans the fuzzy pass must not touch) ---- */
    const entities = extractEntities(text);

    // Fuzzy matching is the only superlinear step; skip it on very long input.
    if (fuzzy && text.length <= 20000) {
      const claimed = [
        ...hits.map((h) => [h.index, h.index + h.length]),
        ...entitySpans(text),
      ];
      hits = dedupeOverlaps([...hits, ...fuzzyPass(text, compiled, claimed)]);
    }

    /* ---- polarity, hedging, context ---- */
    for (const h of hits) {
      // Negation never crosses a sentence boundary: "…no lane closure. ROW
      // acquisition is complete." must not mark the acquisition negated.
      const windowStart = Math.max(0, h.index - context);
      const rawBefore = text.slice(windowStart, h.index);
      const before = rawBefore.slice(rawBefore.search(/[.!?;\n][^.!?;\n]*$/) + 1);
      const after = text.slice(h.index + h.length, h.index + h.length + context).split(/[.!?;\n]/)[0];
      h.negated = NEGATORS.test(before) || /\b(?:cancel(?:l?ed)|postponed|has been lifted|reopened)\b/i.test(after);
      h.hedged = HEDGES.test(before) || HEDGES.test(after);
      h.snippet = `${before.replace(/\s+/g, " ")}⟦${h.text}⟧${after.replace(/\s+/g, " ")}`.trim();
      h.effectiveWeight = h.weight * (h.negated ? 0.25 : 1) * (h.hedged ? 0.7 : 1);
    }

    /* ---- scoring: log-damped frequency, so one word repeated 40× can't
           outweigh five distinct on-topic phrases, and negated/hedged hits
           carry their reduced weight through ---- */
    const scoreHits = (list) => {
      const by = {};
      for (const h of list) {
        const c = (by[h.category] ??= { hits: [], terms: new Map(), score: 0 });
        c.hits.push(h);
        const t = c.terms.get(h.canonical) || { count: 0, weight: 0 };
        t.count += 1;
        t.weight += h.effectiveWeight;
        c.terms.set(h.canonical, t);
      }
      for (const [cat, c] of Object.entries(by)) {
        c.score = [...c.terms.values()].reduce(
          (sum, t) => sum + (t.weight / t.count) * (1 + Math.log(t.count)),
          0
        );
        c.label = compiled.taxonomy[cat]?.label ?? cat;
        c.color = compiled.taxonomy[cat]?.color ?? "#555";
        c.distinctTerms = c.terms.size;
      }
      return by;
    };

    /* Context-aware disambiguation: "FEMA" and "ADA" belong to more than one
       department. Score the unambiguous evidence first, then hand each shared
       term to whichever department the rest of the document supports. */
    const sharedSet = new Set(
      hits.filter((h) => (compiled.owners.get(normalize(h.text))?.size ?? 1) > 1)
    );
    if (sharedSet.size) {
      const base = scoreHits(hits.filter((h) => !sharedSet.has(h)));
      for (const h of sharedSet) {
        const owners = [...compiled.owners.get(normalize(h.text))];
        h.owners = owners;
        h.category = owners.reduce(
          (best, c) => ((base[c]?.score ?? 0) > (base[best]?.score ?? 0) ? c : best),
          owners[0]
        );
        h.disambiguated = true;
      }
    }

    const byCategory = scoreHits(hits);

    const total = Object.values(byCategory).reduce((s, c) => s + c.score, 0) || 1;
    const ranked = Object.entries(byCategory)
      .map(([category, c]) => ({
        category,
        label: c.label,
        color: c.color,
        score: Number(c.score.toFixed(2)),
        confidence: Number((c.score / total).toFixed(3)),
        distinctTerms: c.distinctTerms,
        terms: [...c.terms.entries()]
          .sort((a, b) => b[1].count - a[1].count)
          .map(([term, t]) => ({ term, count: t.count })),
      }))
      .sort((a, b) => b.score - a.score);

    const margin = ranked.length > 1 ? ranked[0].confidence - ranked[1].confidence : ranked[0]?.confidence ?? 0;

    /* ---- signals ---- */
    let urgency = 0;
    const urgencyHits = [];
    for (const { re, level } of URGENCY) {
      const found = text.match(re) || [];
      if (found.length) {
        urgency = Math.max(urgency, level);
        urgencyHits.push(...found);
      }
    }

    /* ---- vocabulary discovery: repeated Capitalized Phrases we don't know ---- */
    const suggestions = discoverTerms(text, compiled);

    return {
      hits,
      ranked,
      topCategory: ranked[0] ?? null,
      confidence: ranked[0]?.confidence ?? 0,
      ambiguous: ranked.length > 1 && margin < 0.15,
      entities,
      signals: {
        urgency,
        urgencyLabel: ["none", "informational", "time-sensitive", "urgent"][urgency],
        urgencyHits: [...new Set(urgencyHits.map((u) => u.toLowerCase()))],
        actions: [...new Set((text.match(ACTIONS) || []).map((a) => a.toLowerCase()))],
        negatedHits: hits.filter((h) => h.negated).map((h) => h.canonical),
        hedged: hits.some((h) => h.hedged),
        hasDeadline: entities.date.length > 0 && urgency >= 2,
        hasContact: entities.phone.length + entities.email.length > 0,
      },
      counts: {
        chars: text.length,
        words: (text.match(TOKEN_RE) || []).length,
        sentences: countSentences(text),
        keywords: hits.length,
        distinctKeywords: new Set(hits.map((h) => h.canonical)).size,
        density: Number(((hits.length / Math.max(1, (text.match(TOKEN_RE) || []).length)) * 100).toFixed(1)),
      },
      readability: readability(text),
      suggestions,
      highlights: toSegments(text, hits),
    };
  }

  return {
    analyze,
    learn,
    forget,
    get compiled() {
      return compiled;
    },
    get taxonomy() {
      return custom;
    },
  };
}

/* -------------------------------------------------------------------- *
 * 7. SUPPORT
 * -------------------------------------------------------------------- */

/** Keep the longest match at each position; drop anything it swallows. */
function dedupeOverlaps(hits) {
  const sorted = [...hits].sort((a, b) => a.index - b.index || b.length - a.length);
  const kept = [];
  let end = -1;
  for (const h of sorted) {
    if (h.index >= end) {
      kept.push(h);
      end = h.index + h.length;
    }
  }
  return kept;
}

function extractEntities(text) {
  const uniq = (a) => [...new Set(a)];
  const faxes = uniq([...text.matchAll(ENTITY_PATTERNS.fax)].map((m) => m[1]));
  const faxDigits = new Set(faxes.map((f) => f.replace(/\D/g, "")));

  return {
    url: uniq((text.match(ENTITY_PATTERNS.url) || []).map((u) => u.replace(/[.,;:!?)\]}'"]+$/, ""))),
    email: uniq(text.match(ENTITY_PATTERNS.email) || []),
    fax: faxes,
    phone: uniq((text.match(ENTITY_PATTERNS.phone) || []).filter((p) => !faxDigits.has(p.replace(/\D/g, "")))),
    address: uniq((text.match(ENTITY_PATTERNS.address) || []).map((a) => a.trim())),
    time: uniq(text.match(ENTITY_PATTERNS.time) || []),
    date: uniq(text.match(ENTITY_PATTERNS.date) || []),
    money: uniq(text.match(ENTITY_PATTERNS.money) || []),
    percent: uniq(text.match(ENTITY_PATTERNS.percent) || []),
    route: uniq(text.match(ENTITY_PATTERNS.route) || []),
    ordinance: uniq(text.match(ENTITY_PATTERNS.ordinance) || []),
    parcel: uniq(text.match(ENTITY_PATTERNS.parcel) || []),
    measure: uniq(text.match(ENTITY_PATTERNS.measure) || []),
    duration: uniq(text.match(ENTITY_PATTERNS.duration) || []),
  };
}

/* Character ranges owned by entity extractors. The fuzzy pass stays out of
   them, so "3.5 miles", "CR 42" and "2026-114" are never "corrected". */
function entitySpans(text) {
  const spans = [];
  for (const key of ["date", "time", "measure", "duration", "money", "percent", "route", "ordinance", "parcel", "phone", "email", "url", "address"]) {
    for (const m of text.matchAll(ENTITY_PATTERNS[key])) {
      spans.push([m.index, m.index + m[0].length]);
    }
  }
  return spans;
}

const STOP_CAPS =
  /^(?:The|A|An|This|That|These|Those|It|We|You|They|If|In|On|At|For|And|But|Or|Please|Note|Our|Their|His|Her|All|Any|Each|Every|Monday|Tuesday|Wednesday|Thursday|Friday|Saturday|Sunday|January|February|March|April|May|June|July|August|September|October|November|December)$/;

/** Unknown Capitalized Phrases seen 2+ times = candidate vocabulary. */
function discoverTerms(text, compiled) {
  // [ \t]+ not \s+ — a phrase must not run across a line break, or the same
  // phrase gets counted under a different surface each time it appears.
  const phrases =
    text.match(/\b[A-Z][a-z]{2,}(?:[ \t]+(?:of|and|for|the)?[ \t]*[A-Z][a-z]{2,}){0,3}\b/g) || [];
  const freq = new Map();
  for (const raw of phrases) {
    // Drop a leading/trailing stopword picked up by the window.
    const p = raw
      .replace(/^(?:The|A|An|This|That|Our|Their|Please|Note)\s+/, "")
      .replace(/\s+(?:The|A|An|This|That|Our|Their|Please|Note)$/, "")
      .trim();
    if (!p || STOP_CAPS.test(p)) continue;
    const norm = normalize(p);
    if (compiled.lookup.has(norm)) continue;
    if (norm.split(" ").length === 1 && norm.length < 5) continue;
    freq.set(p, (freq.get(p) || 0) + 1);
  }
  return [...freq.entries()]
    .filter(([, n]) => n >= 2)
    .sort((a, b) => b[1] - a[1])
    .slice(0, 8)
    .map(([term, count]) => ({ term, count }));
}

/** Text split into {text, hit?} runs — ready to render with highlighting. */
function toSegments(text, hits) {
  const segs = [];
  let cursor = 0;
  for (const h of [...hits].sort((a, b) => a.index - b.index)) {
    if (h.index > cursor) segs.push({ text: text.slice(cursor, h.index) });
    segs.push({ text: text.slice(h.index, h.index + h.length), hit: h });
    cursor = h.index + h.length;
  }
  if (cursor < text.length) segs.push({ text: text.slice(cursor) });
  return segs;
}

function emptyResult(compiled) {
  return {
    hits: [],
    ranked: [],
    topCategory: null,
    confidence: 0,
    ambiguous: false,
    entities: extractEntities(""),
    signals: {
      urgency: 0,
      urgencyLabel: "none",
      urgencyHits: [],
      actions: [],
      negatedHits: [],
      hedged: false,
      hasDeadline: false,
      hasContact: false,
    },
    counts: { chars: 0, words: 0, sentences: 0, keywords: 0, distinctKeywords: 0, density: 0 },
    readability: null,
    suggestions: [],
    highlights: [],
    _categories: compiled.categories,
  };
}

export { normalize, dedupeOverlaps, toSegments, discoverTerms, extractEntities };


import React, { useMemo, useState } from "react";
import { createMatcher } from "./keywordEngine";

/* Assumes your existing artwork imports:
     import EngineerSet from "./EngineerSet";
     import AuditorSet  from "./AuditorSet";
*/

export default function Creator() {
  const [wordIn, setNewWord] = useState("");
  const [teachTerm, setTeachTerm] = useState("");
  const [teachCat, setTeachCat] = useState("engineer");
  const [vocabVersion, setVocabVersion] = useState(0); // bumped on learn/forget

  // One matcher for the component's lifetime; learning recompiles in place.
  const matcher = useMemo(() => createMatcher(), []);

  // Re-runs on keystroke or after a term is taught. Everything downstream
  // is derived — no effects, no cascade of setStates.
  const result = useMemo(
    () => matcher.analyze(wordIn),
    [wordIn, matcher, vocabVersion]
  );

  const {
    ranked, topCategory, confidence, ambiguous,
    entities, signals, counts, readability, suggestions, highlights, hits,
  } = result;

  /* --- artwork: keyed by canonical term, so every alias, plural, acronym
         and fuzzy hit resolves to the same asset ----------------------- */
  const artwork = useMemo(
    () => ({
      engineer: EngineerSet[0][Math.floor(Math.random() * EngineerSet[0].length)],
      "road closure": EngineerSet[0][Math.floor(Math.random() * EngineerSet[0].length)],
      auditor: AuditorSet[0][Math.floor(Math.random() * AuditorSet[0].length)],
      department: AuditorSet[0][Math.floor(Math.random() * AuditorSet[0].length)],
    }),
    []
  );

  const logos = { auditor: "", engineer: "" };

  // Negated hits ("no lane closure") must not pull in closure artwork.
  const imagesToDisplay = hits
    .filter((h) => !h.negated && artwork[h.canonical])
    .map((h, i) => <g key={`${h.canonical}-${h.index}-${i}`}>{artwork[h.canonical]}</g>);

  const logoToDisplay = [...new Set(hits.map((h) => h.canonical))]
    .filter((c) => logos[c])
    .map((c, i) => (
      <image href={logos[c]} key={c} alt={c} x={100 + i * 70} width={200} y={10} />
    ));

  const teach = () => {
    const t = teachTerm.trim();
    if (!t) return;
    matcher.learn(teachCat, t, 3);
    setTeachTerm("");
    setVocabVersion((v) => v + 1);
  };

  const line = (label, list) =>
    list?.length ? `${label}: ${list.join(", ")}` : "";

  return (
    <div className="creator">
      <svg x="0px" y="0px" width="100%" height="100%" viewBox="0 0 400 327">
        <rect fill="#DEF2FD" width="100%" height="100%" />

        <g fontSize="11" fill="#016082">
          <text x="20" y="80" fontSize="16" fill={topCategory?.color || "#016082"}>
            {topCategory
              ? `${topCategory.label} — ${Math.round(confidence * 100)}%${ambiguous ? " (mixed)" : ""}`
              : "Start typing…"}
          </text>
          <text x="20" y="98">{line("URLs", entities.url)}</text>
          <text x="20" y="114">{line("Emails", entities.email)}</text>
          <text x="20" y="130">{line("Phone", entities.phone)}</text>
          <text x="20" y="146">{line("Fax", entities.fax)}</text>
          <text x="20" y="162">{line("Dates", entities.date)}</text>
          <text x="20" y="178">{line("Times", entities.time)}</text>
          <text x="20" y="194">{line("Routes", entities.route)}</text>
          <text x="20" y="210">{line("Amounts", [...entities.money, ...entities.percent])}</text>
          <text x="20" y="226">{line("Refs", [...entities.ordinance, ...entities.parcel])}</text>
          <text x="20" y="242">{line("Measures", [...entities.measure, ...entities.duration])}</text>
          <text x="20" y="258">{line("Address", entities.address)}</text>
          <text x="20" y="278" fill="#D35400">
            {signals.urgency ? `Urgency: ${signals.urgencyLabel}` : ""}
          </text>
        </g>

        <g>{logoToDisplay}</g>
        <g transform="scale(5.8)">{imagesToDisplay}</g>
      </svg>

      <textarea
        placeholder="Start Typing Here .... "
        value={wordIn}
        onChange={(e) => setNewWord(e.target.value)}
        rows={8}
      />

      {/* live routing confidence across every department */}
      <ul className="routing">
        {ranked.map((r) => (
          <li key={r.category}>
            <span style={{ color: r.color }}>{r.label}</span>
            <meter min={0} max={1} value={r.confidence} />
            {Math.round(r.confidence * 100)}% · {r.distinctTerms} terms
          </li>
        ))}
      </ul>

      {/* matched keywords, with why-it-counted annotations */}
      <div className="chips">
        {hits.map((h, i) => (
          <span
            key={`${h.canonical}-${h.index}-${i}`}
            title={h.snippet}
            className={[
              "chip",
              h.negated && "chip--negated",
              h.hedged && "chip--hedged",
              h.kind === "fuzzy" && "chip--fuzzy",
            ]
              .filter(Boolean)
              .join(" ")}
          >
            {h.text}
            {h.kind === "fuzzy" && ` → ${h.canonical}`}
            {h.negated && " (negated)"}
          </span>
        ))}
      </div>

      {/* highlighted source text */}
      <p className="preview">
        {highlights.map((s, i) =>
          s.hit ? (
            <mark key={i} data-category={s.hit.category} data-negated={!!s.hit.negated}>
              {s.text}
            </mark>
          ) : (
            <React.Fragment key={i}>{s.text}</React.Fragment>
          )
        )}
      </p>

      {/* the learning loop: unknown repeated phrases, one click to adopt */}
      {suggestions.length > 0 && (
        <div className="suggestions">
          New phrases seen more than once:
          {suggestions.map((s) => (
            <button
              key={s.term}
              onClick={() => {
                matcher.learn(topCategory?.category || "engineer", s.term, 3);
                setVocabVersion((v) => v + 1);
              }}
            >
              + {s.term} ({s.count})
            </button>
          ))}
        </div>
      )}

      <div className="teach">
        <input
          value={teachTerm}
          placeholder="Teach a keyword…"
          onChange={(e) => setTeachTerm(e.target.value)}
          onKeyDown={(e) => e.key === "Enter" && teach()}
        />
        <select value={teachCat} onChange={(e) => setTeachCat(e.target.value)}>
          {Object.entries(matcher.taxonomy).map(([key, def]) => (
            <option key={key} value={key}>
              {def.label}
            </option>
          ))}
        </select>
        <button onClick={teach}>Add</button>
      </div>

      <p className="stats">
        <b>{counts.words}</b> words · {counts.sentences} sentences · {counts.chars} chars ·{" "}
        {counts.distinctKeywords} distinct keywords · {counts.density}% density
        {readability && ` · ${readability.label} (grade ${readability.grade})`}
      </p>
    </div>
  );
}




