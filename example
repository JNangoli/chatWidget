        const eventLayer = L.layerGroup().addTo(map);

        /*
         * =========================================================
         * DOM
         * =========================================================
         */

        const countySelect = document.getElementById("county");
        const loadBtn = document.getElementById("loadBtn");
        const refreshBtn = document.getElementById("refreshBtn");
        const statusEl = document.getElementById("status");
        const eventsEl = document.getElementById("events");
        const panelTitle = document.getElementById("panelTitle");
        const panelCount = document.getElementById("panelCount");
        const lastUpdateEl = document.getElementById("lastUpdate");

        /*
         * =========================================================
         * APPLICATION STATE
         * =========================================================
         */

        let countyCollection = null;
        let currentCounty = null;
        let serviceURLCache = null;
        let layerURLCache = null;
        let isLoading = false;

        /*
         * =========================================================
         * COUNTY SELECT
         * =========================================================
         */

        COUNTIES
            .slice()
            .sort((a, b) => a[0].localeCompare(b[0]))
            .forEach(([name, countyFips]) => {
                const option = document.createElement("option");

                option.value = IOWA_FIPS + countyFips;
                option.textContent = name;

                countySelect.appendChild(option);
            });

        /*
         * =========================================================
         * EVENTS
         * =========================================================
         */

        loadBtn.addEventListener("click", () => {
            loadSelectedCounty();
        });

        refreshBtn.addEventListener("click", () => {
            loadSelectedCounty();
        });

        countySelect.addEventListener("change", () => {
            if (countySelect.value) {
                loadSelectedCounty();
            }
        });

        window.setInterval(() => {
            if (currentCounty && !isLoading) {
                loadSelectedCounty();
            }
        }, AUTO_REFRESH_MS);

        /*
         * =========================================================
         * MAIN LOAD FLOW
         * =========================================================
         */

        async function loadSelectedCounty() {
            const fips = countySelect.value;

            if (!fips) {
                setStatus("Please select an Iowa county.", "error");
                return;
            }

            const countyName =
                countySelect.options[countySelect.selectedIndex].textContent;

            setLoading(true);

            setStatus(
                `Loading current Iowa 511 information for ${countyName} County…`,
                "loading"
            );

            try {
                const countyFeature = await loadCountyBoundary(fips);

                currentCounty = {
                    fips,
                    name: countyName,
                    feature: countyFeature
                };

                drawCounty(countyFeature);

                let events = [];

                try {
                    events = await load511EventsForCounty(countyFeature);
                } catch (spatialQueryError) {
                    console.warn(
                        "Spatial query failed; using statewide fallback.",
                        spatialQueryError
                    );

                    const statewideEvents = await loadAll511Events();

                    events = statewideEvents.filter((event) => {
                        return geometryIntersectsCounty(
                            event,
                            countyFeature
                        );
                    });
                }

                sortEvents(events);

                displayEvents(events, countyName);

                const now = new Date();

                lastUpdateEl.textContent =
                    `Browser refreshed: ${now.toLocaleString()}`;

                setStatus(
                    `${countyName} County loaded. ` +
                    `${events.length} current 511 event(s) found.`,
                    "success"
                );

                refreshBtn.disabled = false;
            } catch (error) {
                console.error(error);

                eventLayer.clearLayers();

                panelTitle.textContent = "Road updates";
                panelCount.textContent = "Unable to load updates";

                eventsEl.innerHTML = `
                    <div class="empty">
                        <strong>Unable to load road updates.</strong>
                        <br><br>
                        ${escapeHtml(
                            error && error.message
                                ? error.message
                                : "An unexpected error occurred."
                        )}
                    </div>
                `;

                setStatus(
                    `Error: ${
                        error && error.message
                            ? error.message
                            : "Unable to load Iowa 511 data."
                    }`,
                    "error"
                );
            } finally {
                setLoading(false);
            }
        }

        /*
         * =========================================================
         * COUNTY BOUNDARIES
         * =========================================================
         */

        async function loadCountyBoundary(fips) {
            if (!countyCollection) {
                const response = await fetch(COUNTY_GEOJSON_URL);

                if (!response.ok) {
                    throw new Error(
                        "Could not download Iowa county boundaries."
                    );
                }

                countyCollection = await response.json();
            }

            const countyFeature = countyCollection.features.find((feature) => {
                return String(feature.id).padStart(5, "0") === String(fips);
            });

            if (!countyFeature) {
                throw new Error("County boundary not found.");
            }

            return countyFeature;
        }

        function drawCounty(feature) {
            countyLayer.clearLayers();
            countyLayer.addData(feature);

            const bounds = countyLayer.getBounds();

            if (bounds.isValid()) {
                map.fitBounds(bounds, {
                    padding: [28, 28],
                    maxZoom: 10
                });
            }
        }

        /*
         * =========================================================
         * IOWA 511 SERVICE DISCOVERY
         * =========================================================
         */

        async function get511ServiceURL() {
            if (serviceURLCache) {
                return serviceURLCache;
            }

            const itemURL =
                "https://www.arcgis.com/sharing/rest/content/items/" +
                `${IOWA_511_ITEM_ID}?f=json`;

            const response = await fetch(itemURL);

            if (!response.ok) {
                throw new Error(
                    "Could not contact ArcGIS to locate the Iowa 511 service."
                );
            }

            const item = await response.json();

            if (item.error) {
                throw new Error(
                    item.error.message ||
                    "ArcGIS returned an error while locating Iowa 511."
                );
            }

            if (!item.url) {
                throw new Error(
                    "The Iowa 511 traffic-event service URL was not found."
                );
            }

            serviceURLCache = item.url.replace(/\/$/, "");

            return serviceURLCache;
        }

        async function get511LayerURL() {
            if (layerURLCache) {
                return layerURLCache;
            }

            const serviceURL = await get511ServiceURL();

            const response = await fetch(`${serviceURL}?f=json`);

            if (!response.ok) {
                throw new Error("Unable to read Iowa 511 service metadata.");
            }

            const service = await response.json();

            if (service.error) {
                throw new Error(
                    service.error.message ||
                    "Iowa 511 service metadata returned an error."
                );
            }

            if (service.layers && service.layers.length > 0) {
                const eventLayer =
                    service.layers.find((layer) => {
                        const layerName = String(layer.name || "").toLowerCase();

                        return (
                            layerName.includes("event") ||
                            layerName.includes("traveler") ||
                            layerName.includes("511")
                        );
                    }) || service.layers[0];

                layerURLCache = `${serviceURL}/${eventLayer.id}`;

                return layerURLCache;
            }

            if (service.type === "Feature Layer") {
                layerURLCache = serviceURL;
                return layerURLCache;
            }

            throw new Error(
                "No usable Iowa 511 traffic-event feature layer was found."
            );
        }

        /*
         * =========================================================
         * IOWA 511 QUERIES
         * =========================================================
         */

        async function load511EventsForCounty(countyFeature) {
            const layerURL = await get511LayerURL();

            const params = new URLSearchParams({
                where: "1=1",
                outFields: "*",
                returnGeometry: "true",
                outSR: "4326",
                geometryType: "esriGeometryPolygon",
                geometry: JSON.stringify(countyFeature.geometry),
                spatialRel: "esriSpatialRelIntersects",
                inSR: "4326",
                f: "geojson"
            });

            const response = await fetch(
                `${layerURL}/query?${params.toString()}`
            );

            if (!response.ok) {
                throw new Error("Iowa 511 county event query failed.");
            }

            const data = await response.json();

            if (data.error) {
                throw new Error(
                    data.error.message ||
                    "Iowa 511 returned an error for the county query."
                );
            }

            return data.features || [];
        }

        async function loadAll511Events() {
            const layerURL = await get511LayerURL();

            const params = new URLSearchParams({
                where: "1=1",
                outFields: "*",
                returnGeometry: "true",
                outSR: "4326",
                f: "geojson"
            });

            const response = await fetch(
                `${layerURL}/query?${params.toString()}`
            );

            if (!response.ok) {
                throw new Error("Iowa 511 statewide event query failed.");
            }

            const data = await response.json();

            if (data.error) {
                throw new Error(
                    data.error.message ||
                    "Iowa 511 returned an error for the statewide query."
                );
            }

            return data.features || [];
        }

        /*
         * =========================================================
         * GEOMETRY FILTERING
         * =========================================================
         */

        function geometryIntersectsCounty(eventFeature, countyFeature) {
            if (!eventFeature || !eventFeature.geometry) {
                return false;
            }

            try {
                return turf.booleanIntersects(eventFeature, countyFeature);
            } catch (error) {
                console.warn(
                    "Could not test event geometry against county boundary.",
                    error,
                    eventFeature
                );

                return false;
            }
        }

        /*
         * =========================================================
         * DISPLAY
         * =========================================================
         */

        function displayEvents(events, countyName) {
            eventLayer.clearLayers();

            panelTitle.textContent = `${countyName} County Road Updates`;
            panelCount.textContent =
                `${events.length} current event${events.length === 1 ? "" : "s"}`;

            eventsEl.innerHTML = "";

            if (!events.length) {
                eventsEl.innerHTML = `
                    <div class="empty">
                        <strong>No current 511 events found.</strong>
                        <br><br>
                        There are currently no matching Iowa 511 traffic events
                        within ${escapeHtml(countyName)} County.
                    </div>
                `;

                return;
            }

            events.forEach((event, index) => {
                const mapLayer = addEventToMap(event);

                addEventCard(event, index + 1, mapLayer);
            });
        }

        function addEventToMap(event) {
            if (!event || !event.geometry) {
                return null;
            }

            const properties = event.properties || {};
            const type = getEventType(properties);
            const color = getEventColor(type);

            const layer = L.geoJSON(event, {
                pointToLayer: (_feature, latlng) => {
                    return L.circleMarker(latlng, {
                        radius: 8,
                        color,
                        fillColor: color,
                        fillOpacity: 0.9,
                        weight: 2
                    });
                },

                style: {
                    color,
                    weight: 5,
                    opacity: 0.9,
                    fillColor: color,
                    fillOpacity: 0.2
                }
            });

            layer.bindPopup(createPopup(properties));

            layer.addTo(eventLayer);

            return layer;
        }

        function addEventCard(event, number, mapLayer) {
            const properties = event.properties || {};
            const type = getEventType(properties);
            const description = getDescription(properties);
            const road = getRoadName(properties);
            const location = getLocation(properties);
            const severity = getSeverity(properties);
            const date = getDateText(properties);
            const category = classifyEvent(type);

            const card = document.createElement("button");

            card.type = "button";
            card.className = `event-card ${category}`;
            card.setAttribute(
                "aria-label",
                `Show event ${number}: ${type} on the map`
            );

            card.innerHTML = `
                <div class="event-title">${escapeHtml(type)}</div>

                <span class="badge">
                    ${escapeHtml(severity || "Update")}
                </span>

                ${
                    road
                        ? `
                            <div class="event-meta">
                                <strong>Road:</strong>
                                ${escapeHtml(road)}
                            </div>
                        `
                        : ""
                }

                ${
                    location
                        ? `
                            <div class="event-meta">
                                <strong>Location:</strong>
                                ${escapeHtml(location)}
                            </div>
                        `
                        : ""
                }

                <div class="event-description">
                    ${escapeHtml(description)}
                </div>

                ${
                    date
                        ? `
                            <div class="event-meta">
                                <strong>Updated:</strong>
                                ${escapeHtml(date)}
                            </div>
                        `
                        : ""
                }
            `;

            card.addEventListener("click", () => {
                focusEventOnMap(mapLayer);
            });

            eventsEl.appendChild(card);
        }

        function focusEventOnMap(layer) {
            if (!layer) {
                return;
            }

            const bounds = layer.getBounds
                ? layer.getBounds()
                : null;

            if (bounds && bounds.isValid && bounds.isValid()) {
                map.fitBounds(bounds, {
                    padding: [40, 40],
                    maxZoom: 14
                });
            }

            let popupLayer = null;

            layer.eachLayer?.((childLayer) => {
                if (!popupLayer && childLayer.getPopup?.()) {
                    popupLayer = childLayer;
                }
            });

            if (!popupLayer && layer.getPopup?.()) {
                popupLayer = layer;
            }

            if (popupLayer) {
                popupLayer.openPopup();
            }
        }

        function createPopup(properties) {
            const type = getEventType(properties);
            const description = getDescription(properties);
            const road = getRoadName(properties);
            const location = getLocation(properties);
            const severity = getSeverity(properties);
            const date = getDateText(properties);

            return `
                <div style="min-width:220px;max-width:340px">
                    <strong>${escapeHtml(type)}</strong>

                    ${
                        road
                            ? `<br><br><b>Road:</b> ${escapeHtml(road)}`
                            : ""
                    }

                    ${
                        location
                            ? `<br><br><b>Location:</b> ${escapeHtml(location)}`
                            : ""
                    }

                    ${
                        severity
                            ? `<br><br><b>Severity:</b> ${escapeHtml(severity)}`
                            : ""
                    }

                    <br><br>${escapeHtml(description)}

                    ${
                        date
                            ? `<br><br><small><b>Updated:</b> ${escapeHtml(date)}</small>`
                            : ""
                    }
                </div>
            `;
        }

        /*
         * =========================================================
         * EVENT DATA HELPERS
         * =========================================================
         */

        function findProperty(properties, possibleNames) {
            if (!properties || typeof properties !== "object") {
                return "";
            }

            for (const name of possibleNames) {
                const value = properties[name];

                if (
                    value !== undefined &&
                    value !== null &&
                    String(value).trim() !== ""
                ) {
                    return value;
                }
            }

            const lookup = Object.keys(properties).reduce((result, key) => {
                result[key.toLowerCase()] = key;
                return result;
            }, {});

            for (const name of possibleNames) {
                const matchingKey = lookup[name.toLowerCase()];

                if (
                    matchingKey &&
                    properties[matchingKey] !== undefined &&
                    properties[matchingKey] !== null &&
                    String(properties[matchingKey]).trim() !== ""
                ) {
                    return properties[matchingKey];
                }
            }

            return "";
        }

        function getEventType(properties) {
            return String(
                findProperty(properties, [
                    "event_type",
                    "eventtype",
                    "type",
                    "category",
                    "event_category",
                    "event_name",
                    "headline",
                    "title"
                ]) || "Road event"
            );
        }

        function getDescription(properties) {
            return String(
                findProperty(properties, [
                    "description",
                    "comments",
                    "message",
                    "event_description",
                    "details",
                    "narrative",
                    "headline"
                ]) || "No additional description is available."
            );
        }

        function getRoadName(properties) {
            return String(
                findProperty(properties, [
                    "road_name",
                    "road",
                    "route",
                    "route_name",
                    "street",
                    "highway",
                    "roadway"
                ]) || ""
            );
        }

        function getLocation(properties) {
            return String(
                findProperty(properties, [
                    "location",
                    "location_description",
                    "city",
                    "county",
                    "area",
                    "direction"
                ]) || ""
            );
        }

        function getSeverity(properties) {
            return String(
                findProperty(properties, [
                    "severity",
                    "priority",
                    "impact",
                    "event_severity",
                    "level"
                ]) || ""
            );
        }

        function getDateValue(properties) {
            const value = findProperty(properties, [
                "updated",
                "update_time",
                "last_updated",
                "lastupdate",
                "start_time",
                "event_time",
                "created_date",
                "created"
            ]);

            if (!value) {
                return 0;
            }

            if (
                typeof value === "number" ||
                /^\d{13}$/.test(String(value))
            ) {
                const milliseconds = Number(value);

                return Number.isFinite(milliseconds) ? milliseconds : 0;
            }

            const date = new Date(value);
            const time = date.getTime();

            return Number.isNaN(time) ? 0 : time;
        }

        function getDateText(properties) {
            const timestamp = getDateValue(properties);

            if (!timestamp) {
                return "";
            }

            return new Date(timestamp).toLocaleString();
        }

        function sortEvents(events) {
            events.sort((a, b) => {
                return (
                    getDateValue(b.properties || {}) -
                    getDateValue(a.properties || {})
                );
            });
        }

        /*
         * =========================================================
         * EVENT VISUAL CLASSIFICATION
         * =========================================================
         */

        function classifyEvent(type) {
            const value = String(type).toLowerCase();

            if (
                value.includes("closure") ||
                value.includes("closed") ||
                value.includes("restriction")
            ) {
                return "closure";
            }

            if (
                value.includes("construction") ||
                value.includes("work zone") ||
                value.includes("workzone") ||
                value.includes("maintenance")
            ) {
                return "construction";
            }

            if (
                value.includes("warning") ||
                value.includes("hazard") ||
                value.includes("incident") ||
                value.includes("crash") ||
                value.includes("weather")
            ) {
                return "warning";
            }

            return "info";
        }

        function getEventColor(type) {
            const category = classifyEvent(type);

            if (category === "closure") {
                return "#dc2626";
            }

            if (category === "construction") {
                return "#f59e0b";
            }

            if (category === "warning") {
                return "#eab308";
            }

            return "#2563eb";
        }

        /*
         * =========================================================
         * UI HELPERS
         * =========================================================
         */

        function setStatus(message, type = "") {
            statusEl.textContent = message;
            statusEl.className = `status ${type}`.trim();
        }

        function setLoading(loading) {
            isLoading = loading;

            loadBtn.disabled = loading;
            countySelect.disabled = loading;

            if (loading) {
                refreshBtn.disabled = true;
            } else {
                refreshBtn.disabled = !currentCounty;
            }
        }

        function escapeHtml(value) {
            return String(value)
                .replaceAll("&", "&amp;")
                .replaceAll("<", "&lt;")
                .replaceAll(">", "&gt;")
                .replaceAll('"', "&quot;")
                .replaceAll("'", "&#039;");
        }
    </script>
